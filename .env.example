# Neon pooled connection for the serverless runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Optional direct connection for migration commands.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Generate a random value of at least 32 characters. Never use NEXT_PUBLIC_.
AUTH_SECRET=""
ADMIN_USERNAME="basura"
# Generate with: npm run admin:hash
ADMIN_PASSWORD_HASH=""

# Cloudinary server-side credentials; never expose the API secret to the browser.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Argentina country code (54) + mobile prefix (9) + area code (221) + number.
NEXT_PUBLIC_WHATSAPP_NUMBER="5492215487930"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/basura_lp/"
